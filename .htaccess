Options -Indexes
DirectoryIndex index.html index.php
Redirect 301 /pest-control/papatoetoe/ /pest-control/manukau/
ErrorDocument 404 /404.html
RedirectMatch 404 ^/(backup|tmp|source-assets|content|scripts|\.build)(/|$)
RedirectMatch 404 ^/(preview-router\.php|reviews/lib\.php|package\.json)$
<FilesMatch "\.(zip|sqlite|db|log|env)$">
Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} =davispestsol.co.nz [OR]
RewriteCond %{HTTP_HOST} =www.davispestsol.co.nz
RewriteRule ^ https://davispestsol.co.nz%{REQUEST_URI} [R=301,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://book.servicem8.com; script-src 'self' 'unsafe-inline'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresDefault "access plus 1 day"
</IfModule>

